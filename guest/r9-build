#!/bin/rc
# r9-build: the build command of a guest (plan 05.3). It changes the namespace and never a file
# of the tree. A copy of r9-cc for each compiler goes in /tmp/r9/shim, which is bound before
# /bin. So mk and pcc reach the shim when they run 6c or /bin/6c, and r9-cc runs the real
# compiler from /$objtype/bin. An install to /$objtype/bin writes the real file, and the calls
# after it use the new compiler, as in a build with no shim.
#
# Do not bind r9-cc over /$objtype/bin/6c. A bind over a file applies everywhere that file is
# reached, so the install of cmd/6c would write the new 6c over r9-cc.
#
# usage: r9-build [dir [target ...]]
# The default is mk install in /sys/src. Each target is a separate mk, in the order given, and
# the first one that fails stops the build. Thus clean install builds each file again. The
# records go to /tmp/r9/compile.jsonl.
#
# The target cross is not a target of mk. mk kernels builds a kernel for each directory in ARCH
# of /sys/src/9/mkfile, and each kernel mkfile sets its own objtype. The boot file system of a
# kernel has programs of its objtype, such as /$objtype/bin/paqfs, and a guest has only the
# programs of its own objtype. For each other objtype of the kernels, cross runs
# objtype=$o mk install in /sys/src, the cross build of the tree (plan 09.1). An objtype that
# already has /$o/bin/paqfs is not built again, so a kept image can go on after a stop.
#
# With $r9ccd set to the address of r9 ccd, such as tcp!10.0.2.2!5640, each compile for the
# machine of the guest goes to rucc on the host. With cc:auto in $r9bringup, a compile that
# rucc fails runs the real compiler, and what rucc said goes to /tmp/r9/rucc.err.

rfork ne
r9=/usr/glenda/r9
dir=/sys/src
if(! ~ $#* 0){
	dir=$1
	shift
}
targets=($*)
if(~ $#targets 0)
	targets=install
mkdir -p /tmp/r9/shim
rm -f /tmp/r9/compile.jsonl /tmp/r9/shim/*
# The record file is made append-only before mk starts. If the first calls of r9-cc made it,
# two of them could each create it, and the second create would remove the first record.
touch /tmp/r9/compile.jsonl
chmod +a /tmp/r9/compile.jsonl
for(c in 6c 7c 8c 5c vc 6a 7a 8a 5a va)
	cp $r9/bin/r9-cc /tmp/r9/shim/$c
bind -b /tmp/r9/shim /bin
cd $dir || exit cd
for(t in $targets){
	if(~ $t cross){
		kernels=`{sed -n '/^ARCH=/,/^$/p' /sys/src/9/mkfile | grep -v '^ARCH|#|^$' | tr -d '\\	 '}
		os=`{{for(k in $kernels) grep '^objtype=' /sys/src/9/$k/mkfile} | sed 's/objtype=//' | sort -u}
		for(o in $os){
			if(! ~ $o $objtype && ! test -x /$o/bin/paqfs){
				echo r9-build: cross $o
				@{cd /sys/src && objtype=$o mk install}
				s=$status
				if(! ~ $s '')
					exit $s
			}
		}
	}
	if not {
		mk $t
		s=$status
		if(! ~ $s '')
			exit $s
	}
}
exit ''
