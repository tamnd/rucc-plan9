# audio/zuke plays the music of a playlist and shows the playlist. The script makes two FLAC files of 2 seconds of silence with audio/flacenc, each with the tags of an artist, an album and a title. audio/mkplist makes the playlist, and zuke reads it from its standard input. The script does not play the music. The q key stops zuke. The mask covers the volume at the bottom right. The volume comes from /dev/volume of the audio device, so it is 100% on 9h and 0% under QEMU with no audio device.
class masked
window 500x300
run mkdir -p /tmp/music; for(t in one two) dd -if /dev/zero -bs 176400 -count 2 >[2]/dev/null | audio/flacenc -T 'ARTIST=glenda' -T 'ALBUM=r9' -T 'TITLE='$t > /tmp/music/$t.flac; audio/mkplist /tmp/music > /tmp/r9.plist; audio/zuke < /tmp/r9.plist
quiet
mask 456 278 500 300
snap open
exit "q"
