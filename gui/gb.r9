# The Game Boy emulator runs a test ROM of 32 KB. The ROM is bands.gb in gui/data/rom, which gui/data/mkroms.py makes. It draws a fixed picture and then loops, so the script is an exact test. The background shows diagonal bands of the 4 greys. The Del key stops the emulator.
class exact
window 500x400
run {mount -nc '#Z/hostfs' /mnt/term >[2]/dev/null || bind /lib/r9data /mnt/term}; games/gb /mnt/term/rom/bands.gb
pause 3
quiet
snap rom
exit "\x7f"
