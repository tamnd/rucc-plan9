# yuv shows a file of 8-bit UYVY video, 96 by 48 pixels. yuv finds the size of the image in /lib/video.specs by the size of the file, so the script binds the lib directory of gui/data before /lib. The script mounts gui/data on /mnt/term. The q key stops yuv.
class exact
window 300x200
run {mount -nc '#Z/hostfs' /mnt/term >[2]/dev/null || bind /lib/r9data /mnt/term}; bind -b /mnt/term/lib /lib; yuv /mnt/term/bars.yuv
quiet
snap image
exit "q"
